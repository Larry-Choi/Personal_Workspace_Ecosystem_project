{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Underdesk Music",
  "version": "0.1.0",
  "identifier": "com.larry.underdeskmusic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Underdesk Music",
        "width": 620,
        "height": 760,
        "minWidth": 340,
        "minHeight": 390,
        "resizable": false,
        "fullscreen": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://www.youtube.com; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https: data:; frame-src https://www.youtube.com https://www.youtube-nocookie.com; connect-src 'self' ipc: http://ipc.localhost https://www.youtube.com https://www.googleapis.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
